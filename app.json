{
  "expo": {
    "name": "EcoAlerta",
    "slug": "EcoAlerta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ECOALERTA - ISO.png",
    "scheme": "ecoalerta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "Ecodatos",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ar.gob.misiones.ecologia.ecoalerta",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/ECOALERTA - ISO.png",
        "backgroundImage": "./assets/images/ECOALERTA - ISO.png",
        "monochromeImage": "./assets/images/ECOALERTA - ISO.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ECOALERTA - ISO.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ECOALERTA-logo-fondo-transparente.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}