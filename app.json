{
  "expo": {
    "name": "EcoDatos",
    "slug": "ecoalerta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ECODATOS-icono.png",
    "scheme": "ecoalerta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "ecodatos",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ar.gob.misiones.ecologia.ecoalerta",
      "adaptiveIcon": {
        "backgroundColor": "#2C4A3A",
        "foregroundImage": "./assets/images/ECODATOS-icono.png",
        "monochromeImage": "./assets/images/ECODATOS-icono.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/ECODATOS-icono.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/solido.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#3E6C51",
          "android": {
      "image": "./assets/images/solido.png",
      "imageWidth": 300,
      "resizeMode": "contain",
      "backgroundColor": "#3E6C51"
    }
        }
      ],
      "expo-audio",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80be80c8-b647-436b-ab69-618afd280c1d"
      }
    }
  }
}