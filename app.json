{
  "expo": {
    "name": "EcoAlerta",
    "slug": "ecoalerta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ECOALERTA - ISO.png",
    "scheme": "ecoalerta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "ecodatos",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ar.gob.misiones.ecologia.ecoalerta",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/ECOALERTA - ISO.png",
        "backgroundImage": "./assets/images/ECOALERTA - ISO.png",
        "monochromeImage": "./assets/images/ECOALERTA - ISO.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ECOALERTA - ISO.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#36382E"
        }
      ],
      "expo-audio",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80be80c8-b647-436b-ab69-618afd280c1d"
      }
    }
  }
}